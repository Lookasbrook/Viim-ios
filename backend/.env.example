NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=
JWT_SECRET=
NEWAGENT_URL=
NEWAGENT_HEALTH_URL=
NEWAGENT_SEND_URL=
NEWAGENT_TOKEN=

# Webhook WhatsApp entrant (GET/POST /v1/webhooks/whatsapp).
# WHATSAPP_VERIFY_TOKEN : chaine libre, a recopier dans la config du webhook Meta.
# Auth des POST : soit WHATSAPP_APP_SECRET (signature X-Hub-Signature-256, Meta en direct),
# soit WHATSAPP_WEBHOOK_SHARED_TOKEN (Bearer, si NEwAGENT-IA relaie les evenements).
# Au moins un des deux est requis en production, sinon les POST renvoient 503.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_SHARED_TOKEN=

# Opt-in des contacts d'urgence. Laisser false tant que l'app iOS n'envoie pas encore
# l'attestation `contactsConsent`. Passer à true refuse (422) toute alerte sans attestation.
REQUIRE_CONTACTS_CONSENT=false
PUBLIC_BASE_URL=https://api.burktech-ia.com

# Dashboard prive : https://api.burktech-ia.com/admin
# Le mot de passe doit contenir au moins 12 caracteres et le secret de session 32.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.yamstack.viim
# Collez la cle .p8 avec les retours a la ligne encodes en \n dans Coolify.
APNS_PRIVATE_KEY=
TZ=UTC
